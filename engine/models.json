  "cost_model": {
    "_doc": "cost_salary_usd is now ENFORCED in economy.mjs: isEligible() applies a dollar wall per model (stops when ledger.costs[id] >= cost_salary_usd), and spend() accumulates --cost into ledger.costs. Origin: termonster usage.jsonl, where cacheWrite dominates cost (observed: opus 'hi' = $0.30 from 30411 cacheWrite tokens). termonster itself has been removed from the box; only this cost model and the economy.mjs wall remain.",
    "source": "termonster usage.jsonl schema: {in,out,cacheRead,cacheWrite,cost,turns} per call",
    "denomination": "usd_per_dispatch",
    "dominant_driver": "cacheWrite",
    "proposed_enforcement": "canAfford(): also stop when sum(ledger.costs[model]) >= model.cost_salary_usd (optional, per-model)",
    "free_pool_cost": 0
  }
